{
  "name": "siyuan-mermaid-wysiwyg-editor",
  "version": "0.3.0",
  "description": "思源笔记 Mermaid 代码块双向可视化编辑插件（block-icon / 快捷键触发，Dialog 承载画布，围栏剥离与包回写回，原生 Markdown 存储零失真）",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "verify:acceptance": "vitest run src/acceptance/acceptance.test.ts"
  },
  "keywords": [
    "siyuan",
    "mermaid",
    "wysiwyg",
    "plugin",
    "visual-editor"
  ],
  "author": "mermaid-wysiwyg",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@visimer/codemirror": "^1.1.2",
    "@visimer/core": "^1.1.2",
    "@visimer/dom": "^1.1.2",
    "mermaid": "^12.0.0",
    "siyuan": "1.2.7"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
